#!/usr/bin/env zsh


# ============================================================
# Setup
# ============================================================
set -eu
setopt pipefail

DOTFILES=${0:A:h}
export HOMEBREW_NO_ANALYTICS=1  # .zprofile isn't linked yet on a fresh machine

# ${1//\%/%%}: print -P would expand a % in a package or profile name.
info()  { print -P "%F{blue}[INFO]%f  ${1//\%/%%}" }
ok()    { print -P "%F{green}[OK]%f    ${1//\%/%%}" }
typeset -a warnings=()
warn()  { print -P "%F{yellow}[WARN]%f  ${1//\%/%%}"; warnings+=("$1") }  # replayed before "All done!"
err()   { print -P "%F{red}[ERROR]%f ${1//\%/%%}" }


# ============================================================
# Flags & prompting
# ============================================================
AUTOYES=false
ALLOW_ADOPT=false
ALLOW_INSECURE=false
PROFILE=""

for arg in "$@"; do
    case $arg in
        --yes|-y)        AUTOYES=true ;;
        --adopt)         ALLOW_ADOPT=true ;;
        --allow-insecure) ALLOW_INSECURE=true ;;
        --profile=?*)    PROFILE=${arg#--profile=} ;;
        -h|--help)
            print -r -- "Usage: ./install [--yes|-y] [--adopt] [--allow-insecure] [--profile=NAME]
  --yes             Non-interactive (auto-yes to all prompts EXCEPT the
                    security-weakening ones, which are skipped instead).
                    A fresh-machine run needs sudo primed first
                    ('sudo -v'): Homebrew's installer uses 'sudo -n' here.
  --adopt           Allow stow --adopt on conflict (DESTRUCTIVE: moves \$HOME files into the repo)
  --allow-insecure  Also auto-yes the prompts that WEAKEN a security control.
                    Only meaningful together with --yes.
  --profile=NAME    Also install Brewfile.NAME (e.g. personal). Remembered in
                    ~/.config/dotfiles/profile, so later runs need no flag."
            exit 0
            ;;
        *) err "Unknown flag: $arg"; exit 2 ;;
    esac
done

ask() {
    if $AUTOYES; then
        info "$1 [auto-yes]"
        return 0
    fi
    read -q "?$1 [y/N] " || { print; return 1 }
    print
}

ask_insecure() {
    if $AUTOYES && ! $ALLOW_INSECURE; then
        warn "$1 [skipped — pass --allow-insecure to accept this non-interactively]"
        return 1
    fi
    ask "$1"
}


# ============================================================
# Architecture
# ============================================================
if [[ $(uname -m) != arm64 ]]; then
    err "Apple Silicon (arm64) required — detected $(uname -m)."
    err "Every Homebrew path here is hardcoded to /opt/homebrew; there is no Intel fallback."
    exit 3
fi


# ============================================================
# Xcode Command Line Tools
# ============================================================
if ! xcode-select -p &>/dev/null; then
    if ask "Install Xcode Command Line Tools?"; then
        info "Installing Xcode Command Line Tools..."
        xcode-select --install || warn "Could not start the CLT installer; waiting for it anyway..."
        waited=0
        until xcode-select -p &>/dev/null; do
            if (( waited >= 900 )); then
                warn "Xcode CLT still absent after 15m; continuing without it."
                break
            fi
            sleep 5
            waited=$(( waited + 5 ))
        done
        xcode-select -p &>/dev/null && ok "Xcode Command Line Tools installed."
    fi
fi


# ============================================================
# Homebrew
# ============================================================
if [[ -x /opt/homebrew/bin/brew ]] && ! command -v brew &>/dev/null; then
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

if ! command -v brew &>/dev/null; then
    if ask "Install Homebrew?"; then
        info "Installing Homebrew..."
        typeset -a brew_env=()
        $AUTOYES && brew_env=(NONINTERACTIVE=1)
        if brew_bootstrap=$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh); then
            env $brew_env /bin/bash -c "$brew_bootstrap" || warn "Homebrew installer exited non-zero, continuing..."
        else
            warn "Could not download the Homebrew installer, continuing..."
        fi
        if [[ -x /opt/homebrew/bin/brew ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv zsh)"
            ok "Homebrew installed."
        else
            warn "Homebrew bootstrap left no /opt/homebrew/bin/brew; skipping all brew steps."
        fi
    fi
fi

if command -v brew &>/dev/null && [[ $(brew --prefix) != /opt/homebrew ]]; then
    warn "brew resolves to $(brew --prefix), not /opt/homebrew: an Intel/Rosetta Homebrew, so its bottles will be x86_64."
fi


# ============================================================
# Brewfile packages
# ============================================================
brew_needs_trust() {
    brew trust --help &>/dev/null && command -v jq &>/dev/null || return 1
    ! brew trust --json v1 2>/dev/null | jq -e --arg t "$1" '.taps | index($t)' >/dev/null
}

handle_tap() {
    local tap=$1
    if (( ! ${${(f)"$(brew tap)"}[(Ie)$tap]} )); then  # not grep -q: under pipefail its early exit SIGPIPEs brew
        ask "Add and trust tap '${tap}'?" || return 0
        brew tap "$tap" || { warn "Failed to tap ${tap}, continuing..."; return 0 }
    elif ! brew_needs_trust "$tap"; then
        info "tap '${tap}' already added, skipping."
        return 0
    else
        ask "Tap '${tap}' is added but NOT trusted — trust it?" \
            || { warn "${tap} left untrusted; its formulae will fail to install."; return 0 }
    fi
    brew trust --tap "$tap" || warn "Failed to trust ${tap}; its formulae will fail to install."
}

typeset -A brew_flag=(brew --formula cask --cask)
typeset -A tool=(mas mas vscode code)

# mas and code can be installed by this same loop, so their lists load on first use.
load_installed() {
    local p
    case $1 in
        mas)    for p in ${(f)"$(mas list 2>/dev/null)"}; do installed[mas:${${=p}[1]}]=1; done ;;
        vscode) for p in ${(f)"$(code --list-extensions 2>/dev/null)"}; do installed[vscode:${p:l}]=1; done ;;
    esac
    loaded[$1]=1
}

# FD 3, not stdin: ask()'s read -q would otherwise eat package lines.
install_brewfile() {
    local line type pkg id key
    while IFS= read -r line <&3; do
        [[ $line =~ '^(brew|cask|tap|mas|vscode)[[:space:]]+"([^"]+)"(,[[:space:]]*id:[[:space:]]*([0-9]+))?' ]] || continue
        type=$match[1] pkg=$match[2] id=${match[4]-} key=$match[1]:${match[2]:t}
        case $type in
            tap)
                handle_tap "$pkg"
                continue
                ;;
            mas|vscode)
                if ! command -v ${tool[$type]} &>/dev/null; then
                    (( ${+loaded[$type]} )) || warn "${tool[$type]} not found, skipping ${type} entries."
                    loaded[$type]=1
                    continue
                fi
                (( ${+loaded[$type]} )) || load_installed $type
                [[ $type == mas ]] && key=mas:$id || key=vscode:${pkg:l}
                ;;
        esac
        (( ${+installed[$key]} )) && { info "'${pkg}' already installed, skipping."; continue }
        ask "Install ${type} '${pkg}'?" || continue
        case $type in
            brew|cask) brew install ${brew_flag[$type]} "$pkg" ;;
            mas)       mas install "$id" ;;
            vscode)    code --install-extension "$pkg" ;;
        esac && installed[$key]=1 || warn "Failed to install ${pkg}, continuing..."  # a later duplicate is skipped
    done 3< $1
}

# --- Profile ---
# Brewfile is shared; Brewfile.<profile> and the untracked Brewfile.local add to it, read in that order.
profile_file=${HOME}/.config/dotfiles/profile
if [[ -z $PROFILE && -e $profile_file ]]; then
    PROFILE=$(<$profile_file)
elif [[ -z $PROFILE ]]; then
    if $AUTOYES; then
        warn "No profile set: installing the shared Brewfile only. Re-run with --profile=NAME."
    else
        profiles=(${DOTFILES}/Brewfile.*(N:e))
        read -r "PROFILE?Profile for this Mac (have: ${(j:, :)${profiles:#local}}; blank for shared only): " || PROFILE=""
    fi
fi
if [[ -n $PROFILE && ( ! $PROFILE =~ '^[a-z0-9-]+$' || $PROFILE == local ) ]]; then  # local: Brewfile.local is read anyway
    warn "Ignoring invalid profile '${PROFILE}'."
    PROFILE=""
fi
if ! $AUTOYES || [[ -n $PROFILE ]]; then
    mkdir -p ${profile_file:h}
    print -r -- $PROFILE > $profile_file  # blank too, so a shared-only Mac isn't asked again
fi

brewfiles=(${DOTFILES}/Brewfile)
if [[ -n $PROFILE ]]; then
    if [[ -f ${DOTFILES}/Brewfile.${PROFILE} ]]; then
        brewfiles+=(${DOTFILES}/Brewfile.${PROFILE})
    else
        info "No Brewfile.${PROFILE}; profile '${PROFILE}' adds no packages."
    fi
fi
if [[ -f ${DOTFILES}/Brewfile.local ]]; then
    brewfiles+=(${DOTFILES}/Brewfile.local)
fi

if command -v brew &>/dev/null; then
    typeset -A installed loaded  # loaded: list read, or tool missing and already warned
    for p in ${(f)"$(brew list --formula 2>/dev/null)"}; do installed[brew:$p]=1; done
    for p in ${(f)"$(brew list --cask 2>/dev/null)"};    do installed[cask:$p]=1; done

    for brewfile in $brewfiles; do
        info "Reading ${brewfile:t}..."
        install_brewfile $brewfile
    done

    if command -v tldr &>/dev/null; then
        info "Updating tldr cache..."
        tldr --update >/dev/null 2>&1 || warn "tldr cache update failed, continuing..."
    fi
fi


# ============================================================
# Stow
# ============================================================
stow_pkg() { stow -d ${DOTFILES} -t ${HOME} --no-folding "$@" }

if command -v stow &>/dev/null; then
    if ask "Stow dotfiles?"; then
        for dir in ${DOTFILES}/*(/); do
            pkg=${dir:t}
            if conflicts=$(stow_pkg -n -R ${pkg} 2>&1); then
                stow_pkg -R ${pkg}
                ok "${pkg} stowed."
            elif $ALLOW_ADOPT; then
                warn "${pkg} has conflicts; --adopt set, resolving..."
                stow_pkg --adopt -R ${pkg}
                warn "Adopted ${pkg}: review 'git diff' for clobbered tracked files."
            else
                err "${pkg} has conflicts with files in \$HOME."
                print -r -- "$conflicts" >&2
                err "Re-run with --adopt to resolve (DESTRUCTIVE: moves \$HOME files into the repo, overwriting tracked configs)."
                exit 1
            fi
        done
    fi
else
    warn "stow not found, skipping dotfile linking."
fi

# --- btop theme ---
if command -v btop &>/dev/null; then
    btop_conf="${HOME}/.config/btop/btop.conf"
    if [[ ! -f $btop_conf ]]; then
        mkdir -p "${btop_conf:h}"
        print 'color_theme = "catppuccin_frappe"' > "$btop_conf"
        ok "btop theme seeded (catppuccin_frappe)."
    fi
fi

# --- Git hooks ---
# Repo-local config, not the tracked .gitconfig: every commit here runs .githooks/checks.zsh.
if command -v git &>/dev/null \
    && [[ $(git -C ${DOTFILES} config --local core.hooksPath 2>/dev/null) != .githooks ]]; then
    if git -C ${DOTFILES} config --local core.hooksPath .githooks; then
        ok "Pre-commit checks enabled for this repo."
    else
        warn "Could not set core.hooksPath; commits here skip the checks."
    fi
fi


# ============================================================
# macOS defaults
# ============================================================

# --- Finder ---
if ask "Apply macOS Finder defaults?"; then
    defaults write NSGlobalDomain AppleShowAllExtensions -bool true
    defaults write com.apple.finder ShowPathbar -bool true
    defaults write com.apple.finder ShowStatusBar -bool true
    defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false
    defaults write com.apple.finder _FXSortFoldersFirst -bool true
    defaults write com.apple.finder _FXSortFoldersFirstOnDesktop -bool true
    defaults write com.apple.finder _FXShowPosixPathInTitle -bool true
    defaults write com.apple.finder ShowRecentTags -bool false
    defaults write com.apple.finder FXRemoveOldTrashItems -bool true    # empty the Trash after 30 days
    # Opaque four-letter codes: Nlsv is list view, SCcf is "search the current
    # folder" rather than the whole Mac, PfHm opens new windows on the home folder.
    defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"
    defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"
    defaults write com.apple.finder NewWindowTarget -string "PfHm"
    for key in ShowHardDrivesOnDesktop ShowExternalHardDrivesOnDesktop \
               ShowRemovableMediaOnDesktop ShowMountedServersOnDesktop; do
        defaults write com.apple.finder $key -bool false
    done
    # No .DS_Store on network or USB volumes. Applies only to volumes mounted
    # after this runs — anything already mounted keeps littering until remount.
    defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
    defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true
    # Can carry restricted flags; unguarded this aborts the run under `set -e`.
    chflags nohidden ~/Library || warn "Could not unhide ~/Library, continuing..."
    killall Finder 2>/dev/null || true
    ok "Finder: extensions, path and status bars shown, list view with folders first, new windows at home, an empty desktop, and the Trash empties after 30 days."
fi

# --- Gatekeeper ---
if ask_insecure "SECURITY: disable the Gatekeeper 'downloaded from the internet' warning?"; then
    defaults write com.apple.LaunchServices LSQuarantine -bool false
    warn "LSQuarantine disabled — macOS will no longer warn on first-run of downloaded apps."
fi

# --- Desktop & Dock ---
if ask "Apply macOS Desktop & Dock defaults?"; then
    defaults write com.apple.dock minimize-to-application -bool true
    defaults write com.apple.dock show-recents -bool false
    defaults write com.apple.dock mru-spaces -bool false          # don't reorder Spaces by recent use
    defaults write com.apple.dock expose-animation-duration -float 0.1
    defaults write com.apple.dock tilesize -int 46
    defaults write com.apple.dock magnification -bool true
    defaults write com.apple.dock largesize -int 106
    defaults write com.apple.dock wvous-br-corner -int 1          # bottom-right hot corner off; macOS ships Quick Note
    defaults write com.apple.dock wvous-br-modifier -int 0
    defaults write com.apple.WindowManager EnableStandardClickToShowDesktop -bool false  # wallpaper click keeps windows
    defaults write com.apple.WindowManager EnableTiledWindowMargins -bool false
    defaults write com.apple.WindowManager StandardHideDesktopIcons -bool true
    defaults write com.apple.WindowManager HideDesktop -bool true
    killall Dock 2>/dev/null || true
    ok "Desktop & Dock: 46 px tiles magnifying to 106 px, no recent apps, Spaces keep their order, no Quick Note hot corner, and clicking the wallpaper no longer hides windows."
fi

# --- Keyboard ---
if ask "Apply macOS keyboard defaults?"; then
    # 15ms ticks, below the System Settings floor of 2. Applies after re-login.
    defaults write NSGlobalDomain KeyRepeat -float 1.5
    # Delay before repeat kicks in — 12 is 180ms, below the UI "Short" minimum (15).
    defaults write NSGlobalDomain InitialKeyRepeat -int 12
    # All off — smart quotes and dashes corrupt code on paste.
    for key in NSAutoCorrectionEnabled NSAutomaticQuoteSubstitutionEnabled \
               NSAutomaticDashSubstitutionEnabled NSAutomaticCapitalizationEnabled \
               NSAutomaticPeriodSubstitutionEnabled NSAutomaticSpellingCorrectionEnabled \
               WebAutomaticSpellingCorrectionEnabled; do
        defaults write NSGlobalDomain $key -bool false
    done
    defaults write com.apple.HIToolbox AppleFnUsageType -int 0    # Globe key does nothing
    # Tab reaches every UI control, not just text fields and lists.
    defaults write NSGlobalDomain AppleKeyboardUIMode -int 3
    # Off means a held key repeats instead of opening the accent picker, which
    # is what makes the repeat rates above apply everywhere.
    defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false
    ok "Keyboard: faster key repeat, no autocorrect or smart quotes, Tab reaches every control, and the Globe key does nothing. Log out for key repeat to take effect."
fi

# --- Screenshots ---
if ask "Apply macOS screenshot defaults?"; then
    # Screenshots go to the clipboard; screen recordings are saved as files.
    defaults write com.apple.screencapture target -string "clipboard"
    defaults write com.apple.screencapture target-screenshot -string "clipboard"
    defaults write com.apple.screencapture target-screenrecording -string "file"
    defaults write com.apple.screencapture location-screenrecording -string "${HOME}/Pictures/Screenshots"
    mkdir -p ${HOME}/Pictures/Screenshots
    defaults write com.apple.screencapture disable-shadow -bool true
    killall SystemUIServer 2>/dev/null || true
    ok "Screenshots: copied to the clipboard without a shadow; screen recordings are saved to ~/Pictures/Screenshots."
fi

# --- Misc power-user ---
if ask "Apply miscellaneous power-user defaults?"; then
    # Save and print panels open expanded. Both keys are needed: the bare name
    # is the legacy one, the "2" suffix is what current macOS actually reads.
    for key in NSNavPanelExpandedStateForSaveMode{,2} PMPrintingExpandedStateForPrint{,2}; do
        defaults write NSGlobalDomain $key -bool true
    done
    defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false
    # Horizontal scroll (the MX Master's thumb wheel) doesn't swipe back/forward.
    defaults write NSGlobalDomain AppleEnableSwipeNavigateWithScrolls -bool false
    defaults write com.apple.menuextra.clock ShowSeconds -bool true
    defaults write com.apple.TimeMachine DoNotOfferNewDisksForBackup -bool true
    defaults write com.apple.TextEdit RichText -int 0 2>/dev/null \
        || warn "TextEdit is sandboxed: set Format → Plain Text in its settings, or give the terminal Full Disk Access."
    killall ControlCenter 2>/dev/null || true      # redraws the menu-bar clock
    ok "Miscellaneous: save and print dialogs open expanded, new documents save locally instead of to iCloud, seconds show in the clock, and Time Machine stops asking about new disks."
fi

if (( ${#warnings} )); then
    print -P "%F{yellow}[WARN]%f  ${#warnings} warning(s) this run:"  # not warn(): it appends
    for w in $warnings; do print -P "        - ${w//\%/%%}"; done
fi

ok "All done!"
