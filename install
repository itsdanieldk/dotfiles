#!/usr/bin/env zsh


# ============================================================
# Setup
# ============================================================
set -eu
setopt pipefail

DOTFILES=${0:A:h}

autoload -U colors && colors
info()  { print -P "%F{blue}[INFO]%f  $1" }
ok()    { print -P "%F{green}[OK]%f    $1" }
warn()  { print -P "%F{yellow}[WARN]%f  $1" }
err()   { print -P "%F{red}[ERROR]%f $1" }


# ============================================================
# Flags & prompting
# ============================================================
AUTOYES=false
ALLOW_ADOPT=false
ALLOW_INSECURE=false

for arg in "$@"; do
    case $arg in
        --yes|-y)        AUTOYES=true ;;
        --adopt)         ALLOW_ADOPT=true ;;
        --allow-insecure) ALLOW_INSECURE=true ;;
        -h|--help)
            print "Usage: ./install [--yes|-y] [--adopt] [--allow-insecure]"
            print "  --yes             Non-interactive (auto-yes to all prompts EXCEPT the"
            print "                    security-weakening ones, which are skipped instead)."
            print "                    A fresh-machine run needs sudo primed first"
            print "                    ('sudo -v'): Homebrew's installer uses 'sudo -n' here."
            print "  --adopt           Allow stow --adopt on conflict (DESTRUCTIVE: moves \$HOME files into the repo)"
            print "  --allow-insecure  Also auto-yes the prompts that WEAKEN a security control."
            print "                    Only meaningful together with --yes."
            exit 0
            ;;
        *) err "Unknown flag: $arg"; exit 2 ;;
    esac
done

ask() {
    if $AUTOYES; then
        info "$1 [auto-yes]"
        return 0
    fi
    read -q "?$1 [y/N] " || { print; return 1 }
    print
}

ask_insecure() {
    if $AUTOYES && ! $ALLOW_INSECURE; then
        warn "$1 [skipped — pass --allow-insecure to accept this non-interactively]"
        return 1
    fi
    ask "$1"
}


# ============================================================
# Architecture
# ============================================================
if [[ $(uname -m) != arm64 ]]; then
    err "Apple Silicon (arm64) required — detected $(uname -m)."
    err "Every Homebrew path here is hardcoded to /opt/homebrew; there is no Intel fallback."
    exit 3
fi


# ============================================================
# Xcode Command Line Tools
# ============================================================
if ! xcode-select -p &>/dev/null; then
    if ask "Install Xcode Command Line Tools?"; then
        info "Installing Xcode Command Line Tools..."
        xcode-select --install || warn "Could not start the CLT installer; waiting for it anyway..."
        waited=0
        until xcode-select -p &>/dev/null; do
            if (( waited >= 900 )); then
                warn "Xcode CLT still absent after 15m; continuing without it."
                break
            fi
            sleep 5
            waited=$(( waited + 5 ))
        done
        xcode-select -p &>/dev/null && ok "Xcode Command Line Tools installed."
    fi
fi


# ============================================================
# Homebrew
# ============================================================
if [[ -x /opt/homebrew/bin/brew ]] && ! command -v brew &>/dev/null; then
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

if ! command -v brew &>/dev/null; then
    if ask "Install Homebrew?"; then
        info "Installing Homebrew..."
        typeset -a brew_env=()
        $AUTOYES && brew_env=(NONINTERACTIVE=1)
        if brew_bootstrap=$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh); then
            env $brew_env /bin/bash -c "$brew_bootstrap" || warn "Homebrew installer exited non-zero, continuing..."
        else
            warn "Could not download the Homebrew installer, continuing..."
        fi
        if [[ -x /opt/homebrew/bin/brew ]]; then
            eval "$(/opt/homebrew/bin/brew shellenv zsh)"
            ok "Homebrew installed."
        else
            warn "Homebrew bootstrap left no /opt/homebrew/bin/brew; skipping all brew steps."
        fi
    fi
fi

if command -v brew &>/dev/null && [[ $(brew --prefix) != /opt/homebrew ]]; then
    warn "brew resolves to $(brew --prefix), not the arm64 prefix /opt/homebrew."
    warn "That is an Intel/Rosetta Homebrew — its bottles will be x86_64."
fi


# ============================================================
# Brewfile packages
# ============================================================
brew_needs_trust() {
    brew trust --help &>/dev/null || return 1
    command -v jq &>/dev/null || return 1
    brew trust --json v1 2>/dev/null | jq -e --arg t "$1" '.taps | index($t)' >/dev/null && return 1
    return 0
}

handle_tap() {
    local pkg=$1
    if brew tap | grep -qxF -- "$pkg"; then
        brew_needs_trust "$pkg" || { info "tap '${pkg}' already added and trusted, skipping."; return 0 }
        ask "Tap '${pkg}' is added but NOT trusted — trust it?" \
            || { warn "${pkg} left untrusted; its formulae will fail to install."; return 0 }
        brew trust --tap "$pkg" || warn "Failed to trust ${pkg}, continuing..."
        return 0
    fi
    ask "Add and trust tap '${pkg}'?" || return 0
    brew tap "$pkg" || { warn "Failed to tap ${pkg}, continuing..."; return 0 }
    brew trust --tap "$pkg" || warn "Tapped ${pkg} but failed to trust it; its formulae will fail to install."
    return 0
}

typeset -A brew_flag=(brew --formula cask --cask)

if command -v brew &>/dev/null; then
    typeset -A installed
    for p in ${(f)"$(brew list --formula 2>/dev/null)"}; do installed[brew:$p]=1; done
    for p in ${(f)"$(brew list --cask 2>/dev/null)"};    do installed[cask:$p]=1; done

    while IFS= read -r line <&3; do
        [[ -z $line || $line == \#* ]] && continue
        [[ $line =~ '^(brew|cask|tap)[[:space:]]+"([^"]+)"' ]] || continue
        type=$match[1] pkg=$match[2]
        if [[ $type == tap ]]; then
            handle_tap "$pkg"
            continue
        fi
        flag=${brew_flag[$type]}
        (( ${+installed[$type:${pkg:t}]} )) && { info "'${pkg}' already installed, skipping."; continue }
        ask "Install ${type} '${pkg}'?" || continue
        brew install $flag "$pkg" || warn "Failed to install ${pkg}, continuing..."
    done 3< ${DOTFILES}/Brewfile

    if command -v tldr &>/dev/null; then
        info "Updating tldr cache..."
        tldr --update >/dev/null 2>&1 || warn "tldr cache update failed, continuing..."
    fi
fi


# ============================================================
# Stow
# ============================================================
# Must precede Oh My Zsh: its --keep-zshrc only protects an EXISTING ~/.zshrc,
# so with none linked yet it writes its template there and this step conflicts.
if command -v stow &>/dev/null; then
    if ask "Stow dotfiles?"; then
        for dir in ${DOTFILES}/*(/); do
            pkg=${dir:t}
            if conflicts=$(stow -d ${DOTFILES} --no-folding -n -R ${pkg} 2>&1); then
                stow -d ${DOTFILES} --no-folding -R ${pkg}
                ok "${pkg} stowed."
            elif $ALLOW_ADOPT; then
                warn "${pkg} has conflicts; --adopt set, resolving..."
                stow -d ${DOTFILES} --no-folding --adopt -R ${pkg}
                warn "Adopted ${pkg}: review 'git diff' for clobbered tracked files."
            else
                err "${pkg} has conflicts with files in \$HOME."
                print -r -- "$conflicts" >&2
                err "Re-run with --adopt to resolve (DESTRUCTIVE: moves \$HOME files into the repo, overwriting tracked configs)."
                exit 1
            fi
        done
    fi
else
    warn "stow not found, skipping dotfile linking."
fi

# --- btop theme ---
if command -v btop &>/dev/null; then
    btop_conf="${HOME}/.config/btop/btop.conf"
    if [[ ! -f $btop_conf ]]; then
        mkdir -p "${btop_conf:h}"
        print 'color_theme = "catppuccin_frappe"' > "$btop_conf"
        ok "btop theme seeded (catppuccin_frappe)."
    fi
fi


# ============================================================
# Oh My Zsh
# ============================================================
if [[ ! -d ${HOME}/.oh-my-zsh ]]; then
    if ask "Install Oh My Zsh?"; then
        info "Installing Oh My Zsh..."

        if omz_bootstrap=$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh); then
            sh -c "$omz_bootstrap" "" --unattended --keep-zshrc \
                || warn "Oh My Zsh installer exited non-zero, continuing..."
        else
            warn "Could not download the Oh My Zsh installer, continuing..."
        fi

        if [[ -d ${HOME}/.oh-my-zsh ]]; then
            ok "Oh My Zsh installed."
        else
            warn "Oh My Zsh is still absent; its theme and plugins will be skipped."
        fi
    fi
fi


# ============================================================
# Oh My Zsh theme & plugins
# ============================================================
ZSH_CUSTOM=${ZSH_CUSTOM:-${HOME}/.oh-my-zsh/custom}

omz_clone() {
    local kind=$1 name=$2 url=$3
    [[ -d ${HOME}/.oh-my-zsh ]] || return 0
    [[ -d ${ZSH_CUSTOM}/${kind}/${name} ]] && return 0
    ask "Install oh-my-zsh ${kind%s} '${name}'?" || return 0
    git clone --depth=1 "$url" "${ZSH_CUSTOM}/${kind}/${name}" \
        || { warn "Failed to clone ${name}, continuing..."; return 0 }
    ok "${name} installed."
}

omz_clone themes  powerlevel10k           https://github.com/romkatv/powerlevel10k.git
omz_clone plugins fzf-tab                 https://github.com/Aloxaf/fzf-tab.git
omz_clone plugins zsh-autosuggestions     https://github.com/zsh-users/zsh-autosuggestions.git
omz_clone plugins zsh-syntax-highlighting https://github.com/zsh-users/zsh-syntax-highlighting.git


# ============================================================
# macOS defaults
# ============================================================

# --- Finder ---
if ask "Apply macOS Finder defaults?"; then
    defaults write NSGlobalDomain AppleShowAllExtensions -bool true
    defaults write com.apple.finder ShowPathbar -bool true
    defaults write com.apple.finder ShowStatusBar -bool true
    defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false
    defaults write com.apple.finder _FXSortFoldersFirst -bool true
    # Opaque four-letter codes: Nlsv is list view, SCcf is "search the current
    # folder" rather than the whole Mac.
    defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"
    defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"
    # No .DS_Store on network or USB volumes. Applies only to volumes mounted
    # after this runs — anything already mounted keeps littering until remount.
    defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true
    defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true
    # Can carry restricted flags; unguarded this aborts the run under `set -e`.
    chflags nohidden ~/Library || warn "Could not unhide ~/Library, continuing..."
    killall Finder 2>/dev/null || true
    ok "Finder defaults applied."
fi

# --- Gatekeeper ---
if ask_insecure "SECURITY: disable the Gatekeeper 'downloaded from the internet' warning?"; then
    defaults write com.apple.LaunchServices LSQuarantine -bool false
    warn "LSQuarantine disabled — macOS will no longer warn on first-run of downloaded apps."
fi

# --- Dock ---
if ask "Apply macOS Dock defaults?"; then
    defaults write com.apple.dock minimize-to-application -bool true
    defaults write com.apple.dock show-recents -bool false
    defaults write com.apple.dock mru-spaces -bool false          # don't reorder Spaces by recent use
    defaults write com.apple.dock expose-animation-duration -float 0.1
    # Magnification pinned off so tilesize is the only size the Dock renders at.
    defaults write com.apple.dock tilesize -int 52
    defaults write com.apple.dock magnification -bool false
    killall Dock 2>/dev/null || true
    ok "Dock defaults applied."
fi

# --- Keyboard ---
if ask "Apply macOS keyboard defaults?"; then
    # 15ms ticks, below the System Settings floor of 2. Applies after re-login.
    defaults write NSGlobalDomain KeyRepeat -float 1.5
    # Delay before repeat kicks in — 12 is 180ms, below the UI "Short" minimum (15).
    defaults write NSGlobalDomain InitialKeyRepeat -int 12
    # All off — smart quotes and dashes corrupt code on paste.
    defaults write NSGlobalDomain NSAutoCorrectionEnabled -bool false
    defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
    defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false
    defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false
    defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false
    defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false
    # Tab reaches every UI control, not just text fields and lists.
    defaults write NSGlobalDomain AppleKeyboardUIMode -int 3
    # Off means a held key repeats instead of opening the accent picker, which
    # is what makes the repeat rates above apply everywhere.
    defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false
    ok "Keyboard defaults applied."
fi

# --- Screenshots ---
if ask "Apply macOS screenshot defaults?"; then
    defaults write com.apple.screencapture location -string "${HOME}/Pictures/Screenshots"
    mkdir -p ${HOME}/Pictures/Screenshots
    defaults write com.apple.screencapture disable-shadow -bool true
    defaults write com.apple.screencapture type -string "png"
    killall SystemUIServer 2>/dev/null || true
    ok "Screenshot defaults applied."
fi

# --- Misc power-user ---
if ask "Apply miscellaneous power-user defaults?"; then
    # Save and print panels open expanded. Both keys are needed: the bare name
    # is the legacy one, the "2" suffix is what current macOS actually reads.
    defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
    defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true
    defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
    defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true
    ok "Miscellaneous defaults applied."
fi

ok "All done!"
