[user]
    email = hey@itsdaniel.dk
    name = itsdanieldk
[credential]
    helper = osxkeychain
[core]
    editor = nvim
    pager = delta
    fsmonitor = true
    untrackedCache = true
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Catppuccin Mocha
[init]
    defaultBranch = main
[pull]
    rebase = true
[push]
    autoSetupRemote = true
    followTags = true
[commit]
    verbose = true
[fetch]
    prune = true
    prunetags = true
    fsckobjects = true
[transfer]
    fsckobjects = true
[receive]
    fsckobjects = true
[merge]
    conflictstyle = zdiff3
[rerere]
    enabled = true
    autoupdate = true
[diff]
    algorithm = histogram
    colorMoved = default
[grep]
    lineNumber = true
[log]
    follow = true
[blame]
    markUnreachableLines = true
[help]
    autocorrect = prompt
[branch]
    sort = -committerdate
[tag]
    sort = -version:refname
[rebase]
    autoStash = true
    updateRefs = true
[alias]
    lg = log --graph --oneline --decorate --all
    last = log -1 HEAD --stat
    undo = reset --soft HEAD~1
    today = "!git log --since=midnight --author=\"$(git config user.name)\" --oneline"
    amend = commit --amend --no-edit
    recent = branch --sort=-committerdate --format='%(committerdate:relative)%09%(refname:short)'
[column]
    ui = auto
# Work identity: applies to any repo under ~/work/ (overrides the personal
# [user] above). The override file is a stow-managed tracked file.
[includeIf "gitdir:~/work/"]
    path = ~/.config/git/config-work
