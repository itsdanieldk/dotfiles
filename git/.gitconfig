# ============================================================
# Identity
# ============================================================
# Personal default. Repos under ~/work/ are overridden by the [includeIf] at
# the bottom of this file, which must stay after this block to take effect.
[user]
    email = hey@itsdaniel.dk
    name = itsdanieldk
[credential]
    helper = osxkeychain


# ============================================================
# Core & pager
# ============================================================
[core]
    editor = nvim
    pager = delta
    fsmonitor = true
    untrackedCache = true
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Catppuccin Frappe


# ============================================================
# Workflow defaults
# ============================================================
[init]
    defaultBranch = main
[pull]
    rebase = true
[push]
    autoSetupRemote = true
    followTags = true
[commit]
    verbose = true
[fetch]
    prune = true
    prunetags = true
    fsckobjects = true


# ============================================================
# Object integrity
# ============================================================
[transfer]
    fsckobjects = true
[receive]
    fsckobjects = true


# ============================================================
# Merge & rebase
# ============================================================
[merge]
    conflictstyle = zdiff3
[rerere]
    enabled = true
    autoupdate = true
[rebase]
    autoStash = true
    updateRefs = true


# ============================================================
# Diff & display
# ============================================================
[diff]
    algorithm = histogram
    colorMoved = default
[grep]
    lineNumber = true
[log]
    follow = true
[blame]
    markUnreachableLines = true
[help]
    autocorrect = prompt
[branch]
    sort = -committerdate
[tag]
    sort = -version:refname
[column]
    ui = auto


# ============================================================
# Aliases
# ============================================================
[alias]
    lg = log --graph --oneline --decorate --all
    last = log -1 HEAD --stat
    undo = reset --soft HEAD~1
    today = "!git log --since=midnight --author=\"$(git config user.name)\" --oneline"
    amend = commit --amend --no-edit
    recent = branch --sort=-committerdate --format='%(committerdate:relative)%09%(refname:short)'


# ============================================================
# Conditional includes
# ============================================================
[includeIf "gitdir/i:~/work/"]
    path = ~/.config/git/config-work
