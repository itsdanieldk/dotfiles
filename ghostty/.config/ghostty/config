# ============================================================
# Font
# ============================================================
font-family = FiraCode Nerd Font Mono

font-size = 14.5


# ============================================================
# macOS
# ============================================================
# right Option still composes Danish [ ] { } \
macos-option-as-alt = left

macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden


# ============================================================
# Window
# ============================================================
window-padding-x = 8
window-padding-y = 8

background-opacity = 0.90
background-blur = 20


# ============================================================
# Behavior
# ============================================================
copy-on-select = clipboard

# bytes of RAM, not lines; ~50k lines at this width
scrollback-limit = 100000000

cursor-style-blink = false

confirm-close-surface = true

# macOS bell is already visual-only (dock bounce + title glyph); nothing to disable.

# xterm-ghostty is unknown to most remote hosts; ssh-terminfo installs it, ssh-env falls back.
shell-integration-features = ssh-env,ssh-terminfo


# ============================================================
# Keyboard (macOS conventions)
# ============================================================

# Terminal actions
keybind = cmd+k=clear_screen

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down

# Close
keybind = cmd+w=close_tab
keybind = cmd+shift+w=close_surface

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+physical:one=goto_tab:1
keybind = cmd+physical:two=goto_tab:2
keybind = cmd+physical:three=goto_tab:3
keybind = cmd+physical:four=goto_tab:4
keybind = cmd+physical:five=goto_tab:5
keybind = cmd+physical:six=goto_tab:6
keybind = cmd+physical:seven=goto_tab:7
keybind = cmd+physical:eight=goto_tab:8
keybind = cmd+physical:nine=goto_tab:9

# Font size — Danish layout puts + on its own key and = behind shift+0, so bind both
keybind = cmd+equal=increase_font_size:1
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+physical:zero=reset_font_size

# Navigate between splits
keybind = cmd+left=goto_split:left
keybind = cmd+right=goto_split:right
keybind = cmd+up=goto_split:up
keybind = cmd+down=goto_split:down

# Layout
keybind = cmd+shift+l=toggle_split_zoom

# Reload config
keybind = cmd+shift+r=reload_config

# cmd+f is Ghostty's own scrollback search — no keybind needed.


# ============================================================
# Theme
# ============================================================
theme = catppuccin-frappe
