# ============================================================
# dotfiles repo — local ignores
# ============================================================
# This repo only; machine-wide ignores live in git/.config/git/ignore.
# No trailing-comment syntax: `pattern  # note` silently stops matching.


# ============================================================
# Claude Code project settings
# ============================================================
# Contents, not the directory: git cannot re-include below an excluded parent.
/.claude/*
!/.claude/skills/
!/.claude/settings.json
CLAUDE.local.md


# ============================================================
# Stow package allowlists
# ============================================================
# --no-folding makes these real dirs in $HOME, so the app writes secrets
# straight into the repo. Ignore everything, re-include only what we track.

# SSH: track only the config — never keys, known_hosts, or other runtime files.
ssh/.ssh/*
!ssh/.ssh/config

# Claude Code: track only settings + statusline — never runtime state or
# credentials (e.g. .credentials.json).
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/statusline.sh

# Git: the work identity is machine-local, like ~/.ssh/config.local. Keep the
# file on disk so stow links it; git ignores a missing includeIf path.
git/.config/git/config-work


# ============================================================
# macOS noise
# ============================================================
# Duplicated from the global ignore on purpose: this repo gets cloned onto
# machines before the global ignore is stowed, so it has to stand alone.
.DS_Store
._*
