# ============================================================
# dotfiles repo — local ignores
# ============================================================
# This repo only; machine-wide ignores live in git/.config/git/ignore.
# No trailing-comment syntax: `pattern  # note` silently stops matching.


# ============================================================
# Claude Code project settings
# ============================================================
# Contents, not the directory: git cannot re-include below an excluded parent.
/.claude/*
!/.claude/skills/
!/.claude/settings.json
CLAUDE.local.md


# ============================================================
# Stow package allowlists
# ============================================================
# Backstop for a stow run without --no-folding, which would fold these dirs into
# repo symlinks and land app secrets in git. Ignore everything, re-include what we track.

# SSH: track only the config — never keys, known_hosts, or other runtime files.
ssh/.ssh/*
!ssh/.ssh/config

# Claude Code: track only settings + statusline — never runtime state or
# credentials (e.g. .credentials.json).
claude/.claude/*
!claude/.claude/settings.json
!claude/.claude/statusline.sh

# GitHub CLI: track only config.yml — never hosts.yml, which holds the token.
gh/.config/gh/*
!gh/.config/gh/config.yml

# k9s: track only config.yaml and skins — never clusters/, screen dumps or benchmarks.
k9s/.config/k9s/*
!k9s/.config/k9s/config.yaml
!k9s/.config/k9s/skins/

# Git: track only the global ignore and allowed_signers — never credentials, which
# git's credential store can write here. The work identity, config-work, is
# machine-local like ~/.ssh/config.local: keep it on disk so stow links it.
git/.config/git/*
!git/.config/git/ignore
!git/.config/git/allowed_signers

# Homebrew: packages for this machine only, such as work tools that shouldn't be public.
/Brewfile.local


# ============================================================
# macOS noise
# ============================================================
# Duplicated from the global ignore on purpose: this repo gets cloned onto
# machines before the global ignore is stowed, so it has to stand alone.
.DS_Store
._*
