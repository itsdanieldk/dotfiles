# Personal Mac only: install reads it after Brewfile, with --profile=personal.

# ============================================================
# Taps
# ============================================================
# Must precede their packages: install walks this file top to bottom and trusts each tap as it's added.
tap "gigalixir/brew"


# ============================================================
# Formulae
# ============================================================

# --- Shell utilities ---
brew "mas"

# --- Languages & runtimes ---
brew "elm"

# --- Databases ---
brew "postgresql@17"  # kebabholdet's prod and CI major; keg-only, .zprofile adds its bin

# --- Hosting ---
brew "gigalixir"


# ============================================================
# Casks
# ============================================================

# --- Windows compatibility ---
cask "crossover"

# --- Media ---
cask "iina"

# --- Games ---
cask "battle-net"
cask "curseforge"
cask "steam"

# --- Communication & remote access ---
cask "discord"
cask "teamviewer"

# --- System & hardware ---
cask "philips-hue-sync"


# ============================================================
# App Store
# ============================================================
# mas only installs apps this Apple ID already owns; sign in to the App Store first.
mas "2FAS - Two Factor Authentication", id: 6443941139
mas "Amphetamine", id: 937984704
mas "Blackmagic Disk Speed Test", id: 425264550
mas "Cinebench", id: 1438772273
mas "DaisyDisk", id: 411643860
mas "Highlighter", id: 1385628859
mas "Keynote Creator Studio", id: 361285480
mas "Numbers Creator Studio", id: 361304891
mas "Pages Creator Studio", id: 361309726
mas "Speedtest", id: 1153157709
mas "uBlock Origin Lite", id: 6745342698
mas "Xcode", id: 497799835
